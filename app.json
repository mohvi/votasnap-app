{
  "expo": {
    "name": "VotaSnap",
    "slug": "votasnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icons/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mz.votasnap.app",
      "associatedDomains": [
        "applinks:votasnap.mz"
      ],
      "icon": "./assets/icons/icon.png"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "mz.votasnap.app",
      "permissions": [],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "votasnap.vercel.app",
              "pathPrefix": "/challenge"
            },
            {
              "scheme": "https",
              "host": "votasnap.vercel.app",
              "pathPrefix": "/entry"
            },
            {
              "scheme": "votasnap",
              "host": "entry"
            },
            {
              "scheme": "votasnap",
              "host": "challenge"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#ff286a",
          "sounds": []
        }
      ],
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-video",
      "expo-web-browser"
    ],
    "scheme": "votasnap",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75a5381a-a892-4dae-ac00-7314b8c84966"
      }
    },
    "owner": "mohvi"
  }
}
