{
  "rules": {
    ".read": "auth != null && auth.token.admin === true",
    ".write": "auth != null && auth.token.admin === true",
    "publicProfiles": {
      ".read": true,
      ".indexOn": [
        "username"
      ]
    },
    "challenges": {
      ".read": true,
      ".indexOn": [
        "status",
        "endsAt"
      ],
      "$challenge": {
        "tieResolvedAt": {
          ".validate": "data.val() === newData.val() || (!data.exists() && data.parent().child('isTie').val() === true && data.parent().child('status').val() === 'pending_confirmation')"
        },
        "confirmedAt": {
          ".validate": "!data.exists() || data.val() === newData.val()"
        }
      }
    },
    "entries": {
      ".read": true,
      "$challenge": {
        ".indexOn": [
          "userId"
        ]
      }
    },
    "votes": {
      "$challenge": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "sponsors": {
      ".read": true
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "pushToken": {
          ".write": "auth != null && auth.uid === $uid && !(data.parent().child('banned').val() === true && !(data.parent().child('bannedUntil').isNumber() && data.parent().child('bannedUntil').val() <= now)) && !data.parent().child('deletionRequestedAt').exists()",
          ".validate": "newData.isString() && newData.val().length <= 250"
        },
        "pushTokenUpdatedAt": {
          ".write": "auth != null && auth.uid === $uid && !(data.parent().child('banned').val() === true && !(data.parent().child('bannedUntil').isNumber() && data.parent().child('bannedUntil').val() <= now)) && !data.parent().child('deletionRequestedAt').exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "snaps": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "bannedUntil": {
          ".validate": "newData.isNumber()"
        },
        "banReason": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "warningsCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "warnings": {
          "$warning": {
            ".validate": "(!data.exists() || data.val() === newData.val()) && newData.hasChildren(['reason', 'createdAt']) && newData.child('reason').isString() && newData.child('reason').val().length >= 5 && newData.child('reason').val().length <= 1000"
          }
        },
        "lastLogin": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === now"
        }
      }
    },
    "snaps_history": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$tx": {
          ".validate": "(!data.exists() || data.val() === newData.val()) && newData.hasChildren(['amount']) && newData.child('amount').isNumber() && (newData.child('type').val() !== 'admin_adjustment' || (newData.child('reason').isString() && newData.child('reason').val().length >= 3 && newData.child('by').isString()))"
        }
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$blockedUid": {
          ".write": "auth != null && auth.uid === $uid && $uid !== $blockedUid",
          ".validate": "newData.val() === true"
        }
      }
    },
    "reports": {
      "$report": {
        ".write": "auth != null && !data.exists() && newData.child('reportedBy').val() === auth.uid && !(root.child('users').child(auth.uid).child('banned').val() === true && !(root.child('users').child(auth.uid).child('bannedUntil').isNumber() && root.child('users').child(auth.uid).child('bannedUntil').val() <= now))",
        ".validate": "auth.token.admin === true || newData.hasChildren(['entryId', 'challengeId', 'reportedBy', 'reason', 'status', 'createdAt'])",
        "reportedBy": {
          ".validate": "auth.token.admin === true || (newData.isString() && newData.val() === auth.uid)"
        },
        "reason": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
        },
        "status": {
          ".validate": "auth.token.admin === true || newData.val() === 'pending'"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$field": {
          ".validate": "auth.token.admin === true || (newData.isString() && newData.val().length <= 2500)"
        }
      }
    },
    "challengeDeals": {
      "$challenge": {
        "amountMzn": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "paymentStatus": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'paid'"
        },
        "paidAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "adminAudit": {
      "$entry": {
        ".validate": "!data.exists() && newData.hasChildren(['action', 'by', 'at']) && newData.child('action').isString() && newData.child('by').child('uid').val() === auth.uid && newData.child('at').val() === now"
      }
    },
    "adminNotes": {
      "$uid": {
        "$note": {
          ".validate": "newData.hasChildren(['text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 2000"
        }
      }
    },
    "inviteCampaigns": {
      ".read": true,
      ".indexOn": [
        "status"
      ]
    },
    "invitedPhones": {
      "$campaign": {
        "$phone": {
          ".read": "auth != null && $phone === auth.token.phone_number.replace('+', '')",
          ".write": "auth != null && !data.exists() && root.child('inviteCampaigns').child($campaign).child('status').val() === 'active' && root.child('inviteCampaigns').child($campaign).child('endsAt').val() > now && $phone.matches(/^258[0-9]{9}$/) && auth.token.phone_number != null && $phone !== auth.token.phone_number.replace('+', '')",
          ".validate": "newData.child('inviterUid').val() === auth.uid && newData.child('at').val() === now && newData.parent().parent().parent().child('inviteSent').child($campaign).child(auth.uid).child($phone).exists()"
        }
      }
    },
    "inviteSent": {
      "$campaign": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$phone": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.parent().parent().parent().parent().child('invitedPhones').child($campaign).child($phone).child('inviterUid').val() === auth.uid && newData.parent().parent().parent().parent().child('inviteSentCount').child($campaign).child(auth.uid).val() <= 200 && ((!root.child('inviteSentCount').child($campaign).child(auth.uid).exists() && newData.parent().parent().parent().parent().child('inviteSentCount').child($campaign).child(auth.uid).val() === 1) || newData.parent().parent().parent().parent().child('inviteSentCount').child($campaign).child(auth.uid).val() === root.child('inviteSentCount').child($campaign).child(auth.uid).val() + 1)"
          }
        }
      }
    },
    "inviteSentCount": {
      "$campaign": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
        }
      }
    },
    "inviteAttributions": {
      "$campaign": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "root.child('inviteCampaigns').child($campaign).child('status').val() === 'active' && root.child('inviteCampaigns').child($campaign).child('endsAt').val() > now && newData.hasChildren(['inviterUid', 'at', 'via']) && newData.child('inviterUid').val() !== auth.uid && root.child('publicProfiles').child(newData.child('inviterUid').val()).child('username').exists() && root.child('publicProfiles').child(auth.uid).child('username').exists() && root.child('users').child(auth.uid).child('createdAt').val() >= root.child('inviteCampaigns').child($campaign).child('startsAt').val() && auth.token.phone_number != null && (!root.child('invitedPhones').child($campaign).child(auth.token.phone_number.replace('+', '')).exists() || root.child('invitedPhones').child($campaign).child(auth.token.phone_number.replace('+', '')).child('inviterUid').val() === newData.child('inviterUid').val()) && newData.child('at').val() === now && newData.parent().parent().parent().child('invitePhonesUsed').child(auth.token.phone_number.replace('+', '')).val() === $campaign && newData.parent().parent().parent().child('inviteProgress').child($campaign).child(newData.child('inviterUid').val()).child('count').exists()"
        }
      }
    },
    "invitePhonesUsed": {
      "$phone": {
        ".write": "auth != null && !data.exists() && $phone === auth.token.phone_number.replace('+', '')",
        ".validate": "newData.isString() && newData.parent().parent().child('inviteAttributions').child(newData.val()).child(auth.uid).exists()"
      }
    },
    "inviteProgress": {
      ".read": true,
      "$campaign": {
        ".indexOn": [
          "count"
        ],
        "$inviter": {
          ".write": "auth != null",
          "count": {
            ".validate": "auth.token.admin === true || (newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1)) && newData.parent().parent().parent().parent().child('inviteAttributions').child($campaign).child(auth.uid).child('inviterUid').val() === $inviter && !root.child('inviteAttributions').child($campaign).child(auth.uid).exists())"
          },
          "updatedAt": {
            ".validate": "auth.token.admin === true || newData.val() === now"
          },
          "$other": {
            ".validate": "auth.token.admin === true"
          }
        }
      }
    },
    "userDemographics": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "birthDate": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.isString() && newData.val().matches(/^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
        },
        "interests": {
          ".write": "auth != null && auth.uid === $uid",
          "$interest": {
            ".validate": "newData.val() === true && $interest.matches(/^[a-z]{3,20}$/)"
          }
        },
        "updatedAt": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "challengeReminders": {
      "$challenge": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('challenges').child($challenge).child('startsAt').val() > now)",
          ".validate": "newData.val() === now"
        }
      }
    },
    "sponsorConsents": {
      "$challenge": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['sponsorId', 'at', 'version']) && newData.child('sponsorId').isString() && newData.child('sponsorId').val() === root.child('challenges').child($challenge).child('sponsorId').val() && newData.child('at').val() === now && newData.child('version').isNumber()",
          "$other": {
            ".validate": "$other === 'sponsorId' || $other === 'at' || $other === 'version'"
          }
        }
      }
    }
  }
}
