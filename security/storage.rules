rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    function image() { return request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    function media() { return image() || (request.resource.size > 0 && request.resource.size <= 50 * 1024 * 1024 && request.resource.contentType.matches('video/(mp4|quicktime)')); }
    match /{path=**} { allow read, write: if admin(); }
    match /avatars/{filename} {
      allow read: if true;
      allow create, update: if request.auth != null && filename == request.auth.uid + '.jpg' && image();
    }
    match /entries/{challengeId}/{uid}/{filename} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && resource == null && media();
    }
    match /challenges/{path=**} { allow read: if true; }
    match /sponsors/{path=**} { allow read: if true; }
  }
}
